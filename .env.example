# Copy to .env and fill in. Never commit .env.

# Transcription (Scribe) and voices (TTS)
ELEVENLABS_API_KEY=
# Translation (default model gpt-5.4-mini)
OPENAI_API_KEY=
# Only when using a gemini-* translation model
GEMINI_API_KEY=
# pyannote diarization: accept the terms at hf.co/pyannote/speaker-diarization-3.1 first
HF_TOKEN=

# Web studio. Without DUB_PASSWORD the server only listens on this computer (127.0.0.1).
# DUB_HOST=0.0.0.0
# DUB_PORT=8000
# DUB_USER=dub
# DUB_PASSWORD=
# DUB_DATA=data
